# Environment for docker-compose.example.yml — copy to compose.env and edit.
# NEVER commit the real file.

# Bearer key required by the serving engines themselves
VLLM_API_KEY_PRIMARY=change-me
VLLM_API_KEY_AUX=change-me

# LiteLLM gateway env (gateway/stack)
LITELLM_MASTER_KEY=change-me
# VLLM_API_KEY_PRIMARY / VLLM_API_KEY_AUX are read by config.example.yaml
# via os.environ/... resolution — same values as above.
