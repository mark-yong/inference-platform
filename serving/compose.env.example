# Environment for docker-compose.example.yml; copy to compose.env and edit.
# NEVER commit the real file. One env file per service: each container gets
# only the credentials it needs.

# ---- primary-chat service (vLLM TP2) ----
# vLLM enables bearer auth from this exact variable name (or --api-key);
# VLLM_API_KEY_PRIMARY would not be read by stock vLLM.
VLLM_API_KEY=change-me-primary
VLLM_SERVED_MODEL_NAME=primary-chat

# ---- aux-35b service (vLLM single GPU) ----
# Auxiliary GPU runs its own file (compose.env.aux) with:
#   VLLM_API_KEY=change-me-aux
#   VLLM_SERVED_MODEL_NAME=aux-35b

# ---- gateway (gateway/stack only; serving containers never see this) ----
# LITELLM_MASTER_KEY=change-me
# The gateway's own env resolves the backend keys by name:
#   VLLM_API_KEY_PRIMARY=<same value as primary compose.env>
#   VLLM_API_KEY_AUX=<same value as aux compose.env>
#   LITELLM_MASTER_KEY=<gateway client key>
