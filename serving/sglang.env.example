# Environment for the SGLang stack (docker-compose.sglang-glm53.example.yml).
# Copy to sglang.env and edit. NEVER commit the real file.
#
# These values are interpolated by Compose itself; run:
#   docker compose --env-file sglang.env \
#     -f docker-compose.sglang-glm53.example.yml up -d

# Engine image tag (pinned; production adds a digest)
IMAGE_TAG=0.4.3
# Host port on the serving host's LAN IP
PORT=8013
# Model weights directory (read-only mount) and cache root (read-write)
MODEL_DIR=/models/glm53
CACHE_DIR=/docker/stacks-data/glm53-flash-sm120/cache
# Host-RAM HiCache tier in GB (needs this much free host RAM)
HICACHE_SIZE_GB=32
